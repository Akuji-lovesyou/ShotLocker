from tkinter import *
from tkinter import ttk
from PIL import Image, ImageTk


root = Tk()
root.title("Testing")
root.geometry("1920x1080")


mainframe = ttk.Frame(root, padding=5)
mainframe.grid(column=0, row=0)


raw_img = Image.open("WoW_forever.png")
scaled_img = raw_img.resize((160, 240), Image.Resampling.LANCZOS)
cover_photo = ImageTk.PhotoImage(scaled_img)

game_count = 13 ## This and the below variables need to be saved somewhere in the code that wont be wrote over
columns = 6
game = 0

for i in range(game_count):
    row_count = i // columns
    col = i % columns
    WoW_forever = ttk.Button(mainframe, image=cover_photo,)
    WoW_forever.grid(column=col, row=row_count)


root.mainloop()